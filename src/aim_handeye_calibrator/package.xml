<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aim_handeye_calibrator</name>
  <version>0.0.1</version>
  <description>ROS 2 chessboard-based camera intrinsic and hand-eye calibration tools for the sentry aim system.</description>
  <maintainer email="xylin@example.com">xylin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>aim_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>
  <depend>rclcpp</depend>
  <depend>gimbal_driver</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
